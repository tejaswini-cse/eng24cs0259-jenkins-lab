import pytest
from calcular import add,substract,multiply,divide

def test_add():
  assert add(2,3)==5

def test_substract():
  assert substract(10,4)==6

def test_multiply():
  assert add(3,4)==12

def test_divide():
  assert divide(10,2)==5

def test_divide_by_zero():
  with pytest.raises(ValueError):
    divide(5,0)
  
